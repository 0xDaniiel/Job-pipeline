# Copy this file to .env.local and fill in real values. Never commit .env.local to git.
# cp .env.local.example .env.local

# --- Google Sheets ---
# Path to the service account JSON key you downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/home/youruser/credentials/job-bot-key.json
# The ID from your sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_TAB=Sheet1

# --- Email (daily digest AND email-based auto-apply) ---
# Gmail recommended. Must be an App Password, not your normal password:
# Google Account > Security > 2-Step Verification > App Passwords.
SMTP_EMAIL=dannydotdev@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
DIGEST_RECIPIENT_EMAIL=dannydotdev@gmail.com

# --- Matching ---
MINIMUM_MATCH_SCORE=55

# --- Your identity, used in auto-apply emails ---
YOUR_NAME=Daniel Chimezie
YOUR_LINKEDIN=https://linkedin.com/in/0xdaniiel2
YOUR_GITHUB=https://github.com/0xDaniiel
YOUR_PORTFOLIO=https://0xdaniiel.space

# --- Security ---
# A random string only you and your cron job know. Protects /api/run from
# being triggered by random internet traffic. Generate one with:
#   openssl rand -hex 24
CRON_SECRET=change_this_to_a_random_string
