# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real secret.

# --- Google Sheets ---
# Use ONE of the two key options below.
# Your PC and the VPS: path to the service account key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/credentials/keys.json
# Vercel: the whole key file as one line of text (leave the line above out there)
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_TAB=Sheet1

# --- Email ---
# Gmail needs an App Password, not your normal password.
SMTP_EMAIL=you@example.com
SMTP_APP_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
DIGEST_RECIPIENT_EMAIL=you@example.com

# --- Matching ---
MINIMUM_MATCH_SCORE=55
AUTO_APPROVE_MIN_SCORE=80
REQUIRE_REMOTE=false

# --- Email applications ---
AUTO_SEND_EMAILS=false
MAX_EMAILS_PER_RUN=10

# --- Your details (used in application emails) ---
YOUR_NAME=Your Name
YOUR_LINKEDIN=https://linkedin.com/in/your-profile
YOUR_GITHUB=https://github.com/your-username
YOUR_PORTFOLIO=https://your-site.example

# --- Dashboard login ---
# Required on Vercel: with these empty, the dashboard refuses to start in
# production. On your own PC, leaving them empty keeps it open.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Local use only (not needed on Vercel or the VPS) ---
CRON_SECRET=
ALLOW_CLEAR=false